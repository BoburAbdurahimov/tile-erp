# Copy to .env and fill in. .env is gitignored and must never be committed.
TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tile_erp
HOST=127.0.0.1
PORT=8000
# Public HTTPS URL serving /webapp, required for the Telegram Mini App button
WEBAPP_HTTPS_URL=https://tile-erp-main.vercel.app/webapp
# 1 = bot is read-only (view/reports only), 0 = re-enable entry wizards
BOT_READ_ONLY=1

# Telegram warehouse bot (Skladbot) mirror - READ ONLY.
# Take these from the bot project's Vercel environment variables.
# The ERP only reads this database; it never writes to it.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
